  eventType      String
  payload        Json
  deliveryStatus String     @default("PENDING") // PENDING, SUCCESS, FAILED, DEAD_LETTER, REQUEUED
  responseCode   Int?
  responseBody   String?    @db.Text
  retryCount     Int        @default(0)
  nextRetryAt    DateTime   @default(now())
  createdAt      DateTime   @default(now())
  webhook        ApiWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
}

model ApiClient {
  id             String          @id @default(cuid())
  userId         Int             @unique
  companyName    String?
  ipWhitelist    Json?           // Array of approved IPs
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ApiThreatLog {
  id           Int      @id @default(autoincrement())
  clientId     Int?
  threatType   String   // INVALID_API_KEY, SIGNATURE_FAILURE, IP_VIOLATION, RATE_LIMIT, BURST
  endpoint     String
  ipAddress    String?
  severity     Int      @default(1)
  details      String?  @db.Text
  createdAt    DateTime @default(now())
}

model ApiCreditWallet {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  balance           Decimal  @default(0.00) @db.Decimal(10, 2)
  reservedCredits   Decimal  @default(0.00) @db.Decimal(10, 2)
  usedCredits       Decimal  @default(0.00) @db.Decimal(10, 2)
  lifetimePurchased Decimal  @default(0.00) @db.Decimal(12, 2)
  lifetimeConsumed  Decimal  @default(0.00) @db.Decimal(12, 2)
  updatedAt         DateTime @updatedAt
}
