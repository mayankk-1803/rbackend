generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model commissionRule {
  id                Int      @id @default(autoincrement())
  operator          String
  userTier          String   @default("Standard")
  commissionPercent Float
  cashbackPercent   Float
  priority          Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([operator, userTier, isActive])
}

model fraudlog {
  id          Int                  @id @default(autoincrement())
  userId      Int?
  mobile      String?
  riskScore   Float
  actionTaken fraudlog_actionTaken
  reasons     String?
  txnData     Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        user?                @relation(fields: [userId], references: [id])

  @@index([userId])
}

model operator {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  codes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model payment {
  id              Int            @id @default(autoincrement())
  userId          Int
  amount          Decimal        @db.Decimal(10, 2)
  status          payment_status @default(PENDING)
  idempotencyKey  String         @unique
  upiId           String?
  intent          payment_intent
  gatewayTxnId    String?
  errorMessage    String?
  gatewayUrl      String?        @db.Text
  qrCode          String?        @db.Text
  webhookReceived Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            user           @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
}

model provider {
  id              Int                   @id @default(autoincrement())
  name            String
  code            String                @unique
  baseUrl         String
  apiKey          String
  isActive        Boolean               @default(false)
  isBlacklisted   Boolean               @default(false)
  priority        Int                   @default(0)
  avgResponseTime Float                 @default(0)
  successRate     Float                 @default(100)
  costPerTxn      Decimal               @default(0) @db.Decimal(10, 2)
  healthStatus    provider_healthStatus @default(HEALTHY)
  lastCheckAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([code])
}

model recharge {
  id            Int         @id @default(autoincrement())
  transactionId Int         @unique
  mobile        String
  operator      String
  providerCode  String?
  failureReason String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  transaction   transaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
}

model transaction {
  id              Int                    @id @default(autoincrement())
  userId          Int
  amount          Decimal                @db.Decimal(10, 2)
  type            transaction_type
  status          transaction_status     @default(PENDING)
  direction       transaction_direction?
  balanceAfter    Decimal?               @db.Decimal(10, 2)
  mobile          String?
  operator        String?
  cashback        Decimal                @default(0) @db.Decimal(10, 2)
  cashbackCoins   Int                    @default(0)
  rewardClaimed   Boolean                @default(false)
  commission      Decimal                @default(0) @db.Decimal(10, 2)
  profit          Decimal                @default(0) @db.Decimal(10, 2)
  provider        String?
  providerTxnId   String?
  providerRef     String?                @unique
  amountDeducted  Boolean                @default(false)
  refundStatus    String                 @default("none")
  refundedAt      DateTime?
  idempotencyKey  String?                @unique
  gatewayTxnId    String?
  paymentGateway  String?
  retryCount      Int                    @default(0)
  lastRetryAt     DateTime?
  isLocked        Boolean                @default(false)
  description     String?                @db.VarChar(255)
  invoiceSnapshot Json?
  apiResponse     Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  recharge         recharge?
  user             user                  @relation(fields: [userId], references: [id])
  coinTransactions coinTransaction[]
  disputes         dispute[]
  ledgerEntries    ledgerEntry[]

  @@index([status])
  @@index([type])
  @@index([userId])
  @@index([createdAt])
  @@index([mobile])
}

model ledgerEntry {
  id               Int                @id @default(autoincrement())
  userId           Int
  amount           Decimal            @db.Decimal(10, 2)
  balanceBefore    Decimal            @db.Decimal(10, 2)
  balanceAfter     Decimal            @db.Decimal(10, 2)
  type             ledgerEntry_type
  transactionId    Int?
  referenceEntryId Int?
  description      String?            @db.VarChar(255)
  metadata         Json?
  createdAt        DateTime           @default(now())

  user        user         @relation(fields: [userId], references: [id])
  transaction transaction? @relation(fields: [transactionId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([transactionId])
  @@index([type])
}

model cashbackSettings {
  id                     Int         @id @default(1)
  cashbackEnabled        Boolean     @default(true)
  rewardMode             reward_mode @default(PERCENTAGE)
  coinConversionRate     Int         @default(100)
  minRechargeAmount      Decimal     @default(10) @db.Decimal(10, 2)
  maxCashbackPerRecharge Decimal     @default(50) @db.Decimal(10, 2)
  dailyCashbackLimit     Decimal     @default(500) @db.Decimal(10, 2)
  cooldownSeconds        Int         @default(0)
  globalPercentage       Float       @default(1.0)
  operatorWiseCashback   Json?
  slabWiseCashback       Json?
  cashbackExpiryDays     Int         @default(0) // 0 means no expiry
  updatedById            Int?
  updatedAt              DateTime    @updatedAt

  updatedBy user? @relation(fields: [updatedById], references: [id])
}

model dispute {
  id            Int             @id @default(autoincrement())
  userId        Int
  transactionId Int
  type          String
  description   String          @db.Text
  status        dispute_status  @default(OPEN)
  remarks       String?         @db.Text
  adminId       Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user        user        @relation(fields: [userId], references: [id])
  transaction transaction @relation(fields: [transactionId], references: [id])
  admin       user?       @relation("adminDisputes", fields: [adminId], references: [id])

  @@index([userId])
  @@index([transactionId])
  @@index([status])
}

model auditLog {
  id        Int      @id @default(autoincrement())
  action    String
  adminId   Int?
  userId    Int?
  entity    String?
  entityId  Int?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  admin user? @relation("adminAudit", fields: [adminId], references: [id])
  user  user? @relation("userAudit", fields: [userId], references: [id])

  @@index([adminId])
  @@index([userId])
  @@index([createdAt])
}

model walletSnapshot {
  id          Int      @id @default(autoincrement())
  userId      Int
  balance     Decimal  @db.Decimal(10, 2)
  coinBalance Int
  createdAt   DateTime @default(now())

  user user @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String   @db.Text
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user user @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([isRead])
}

model user {
  id               Int       @id @default(autoincrement())
  name             String?
  email            String?   @unique
  password         String
  phone            String?   @unique
  isPhoneVerified  Boolean   @default(false)
  isEmailVerified  Boolean   @default(false)
  authType         String    @default("phone")
  role             user_role @default(USER)
  referralCode     String?   @unique
  referredBy       Int?
  referralEarnings Decimal   @default(0) @db.Decimal(10, 2)
  tier             String    @default("Standard")
  profileImage     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  apiKeys          apiKey[]
  apiLogs          apiLog[]
  fraudlog         fraudlog[]
  payment          payment[]
  transaction      transaction[]
  coinTransaction  coinTransaction[]
  wallet           wallet?
  ledgerEntries    ledgerEntry[]
  disputes         dispute[]
  adminDisputes    dispute[] @relation("adminDisputes")
  auditLogs        auditLog[] @relation("userAudit")
  adminAuditLogs   auditLog[] @relation("adminAudit")
  walletSnapshots  walletSnapshot[]
  notifications    notification[]
  cashbackSettings cashbackSettings[]

  user       user?  @relation("userToUser", fields: [referredBy], references: [id])
  other_user user[] @relation("userToUser")

  @@index([email])
  @@index([phone])
  @@index([referredBy])
}

model apiKey {
  id            Int      @id @default(autoincrement())
  userId        Int
  clientId      String   @unique
  apiKey        String   @unique
  apiSecret     String   @unique
  webhookSecret String?
  isActive      Boolean  @default(true)
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user user @relation(fields: [userId], references: [id])

  @@index([userId])
}

model apiLog {
  id           Int      @id @default(autoincrement())
  userId       Int
  endpoint     String
  method       String
  statusCode   Int
  latency      Int
  ipAddress    String?
  userAgent    String?
  requestBody  Json?
  responseBody Json?
  createdAt    DateTime @default(now())

  user user @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model OTP {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

model wallet {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  balance         Decimal  @default(0) @db.Decimal(10, 2)
  cashbackBalance Decimal  @default(0) @db.Decimal(10, 2)
  coinBalance     Int      @default(0)
  currency        String   @default("INR")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user user @relation(fields: [userId], references: [id])

  @@index([userId])
}

model coinTransaction {
  id            Int                  @id @default(autoincrement())
  userId        Int
  amount        Int
  type          coinTransaction_type
  description   String?
  rechargeTxnId Int?
  rechargeTxn   transaction?         @relation(fields: [rechargeTxnId], references: [id])
  createdAt     DateTime             @default(now())

  user user @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
  @@unique([rechargeTxnId, type])
}

enum payment_status {
  PENDING
  SUCCESS
  FAILED
}

enum transaction_type {
  RECHARGE
  TOPUP
  REFUND
  CASHBACK
  REFERRAL
  WALLET
  BILL_PAYMENT
  POSTPAID
}

enum fraudlog_actionTaken {
  FLAGGED
  BLOCKED
}

enum transaction_status {
  PENDING
  SUCCESS
  FAILED
}

enum user_role {
  USER
  RETAILER
  DISTRIBUTOR
  ADMIN
  SUPER_ADMIN
}

enum ledgerEntry_type {
  RECHARGE_DEBIT
  CASHBACK_CREDIT
  REFUND_CREDIT
  REDEMPTION_DEBIT
  REVERSAL_CREDIT
  ADMIN_ADJUSTMENT
  TOPUP_CREDIT
}

enum reward_mode {
  PERCENTAGE
  RANDOM
}

enum dispute_status {
  OPEN
  UNDER_REVIEW
  PROVIDER_ESCALATED
  RESOLVED
  REJECTED
}

enum transaction_direction {
  CREDIT
  DEBIT
}

enum payment_intent {
  TOPUP
  RECHARGE
}

enum provider_healthStatus {
  HEALTHY
  DEGRADED
  DOWN
}

enum coinTransaction_type {
  EARNED
  REDEEMED
}