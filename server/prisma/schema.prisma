  serviceCategory ServiceCategory   @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)
  slab            Slab              @relation(fields: [slabId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceCategoryId])
  @@index([packageId])
  @@index([serviceCategoryId])
  @@index([slabId])
}

model RechargeCommissionRule {
  id                Int                 @id @default(autoincrement())
  slabId            Int
  operatorId        Int
  serviceCategoryId Int
  role              CommissionRole
  commissionType    CommissionValueType @default(PERCENTAGE)
  commissionValue   Float               @default(0.0)
  realCommission    Float               @default(0.0)
  surchargeType     CommissionValueType @default(PERCENTAGE)
  surchargeValue    Float               @default(0.0)
  profitType        CommissionValueType @default(PERCENTAGE)
  profitValue       Float               @default(0.0)
  feeType           CommissionValueType @default(PERCENTAGE)
  feeValue          Float               @default(0.0)
  maxCommission     Float?
  fixedCharge       Float               @default(0.0)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  status            CommissionStatus    @default(PENDING)
  approvedById      Int?
  approvedAt        DateTime?
  approvalComment   String?
  version           Int                 @default(1)
  isDeleted         Boolean             @default(false)
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  slab            Slab            @relation(fields: [slabId], references: [id], onDelete: Cascade)
  operatorRel     operator        @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  @@index([slabId, operatorId, serviceCategoryId, role])
  @@index([status])
  @@index([slabId])
  @@index([operatorId])
  @@index([serviceCategoryId])
  @@index([role])
  @@index([isDeleted])
  @@index([operatorId, serviceCategoryId])
  @@index([operatorId, role])
}

model RangeCommissionRule {
  id                Int                 @id @default(autoincrement())
  slabId            Int
  operatorId        Int
  serviceCategoryId Int
  amountFrom        Float
  amountTo          Float
  role              CommissionRole
  mode              CommissionMode      @default(GENERAL)
  commissionType    CommissionValueType @default(PERCENTAGE)
  commissionValue   Float               @default(0.0)
  realCommission    Float               @default(0.0)
  surchargeType     CommissionValueType @default(PERCENTAGE)
  surchargeValue    Float               @default(0.0)
  profitType        CommissionValueType @default(PERCENTAGE)
  profitValue       Float               @default(0.0)
  feeType           CommissionValueType @default(PERCENTAGE)
  feeValue          Float               @default(0.0)
  maxCommission     Float?
  fixedCharge       Float               @default(0.0)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  status            CommissionStatus    @default(PENDING)
  approvedById      Int?
  approvedAt        DateTime?
  approvalComment   String?
  version           Int                 @default(1)
  isDeleted         Boolean             @default(false)
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  slab            Slab            @relation(fields: [slabId], references: [id], onDelete: Cascade)
  operatorRel     operator        @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  @@index([slabId])
  @@index([operatorId])
  @@index([serviceCategoryId])
  @@index([amountFrom])
  @@index([amountTo])
  @@index([role])
  @@index([status])
  @@index([isDeleted])
  @@index([operatorId, serviceCategoryId])
  @@index([operatorId, role])
}

