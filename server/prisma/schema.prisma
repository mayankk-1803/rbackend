generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model commissionRule {
  id                Int      @id @default(autoincrement())
  operator          String
  userTier          String   @default("Standard")
  commissionPercent Float
  cashbackPercent   Float
  priority          Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([operator, userTier, isActive])
}

model fraudlog {
  id          Int                  @id @default(autoincrement())
  userId      Int?
  mobile      String?
  riskScore   Float
  actionTaken fraudlog_actionTaken
  reasons     String?
  txnData     Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        user?                @relation(fields: [userId], references: [id])

  @@index([userId])
}

model operator {
  id            Int                      @id @default(autoincrement())
  name          String                   @unique
  codes         String?
  active        Boolean                  @default(true)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  rechargeRules RechargeCommissionRule[]
  rangeRules    RangeCommissionRule[]
}

model payment {
  id              Int            @id @default(autoincrement())
  userId          Int
  amount          Decimal        @db.Decimal(10, 2)
  status          payment_status @default(PENDING)
  idempotencyKey  String         @unique
  upiId           String?
  intent          payment_intent
  gatewayTxnId    String?
  errorMessage    String?
  gatewayUrl      String?        @db.Text
  qrCode          String?        @db.Text
  webhookReceived Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            user           @relation(fields: [userId], references: [id])
  order           Order?

  @@index([status])
  @@index([userId])
}

model provider {
  id              Int                   @id @default(autoincrement())
  name            String
  code            String                @unique
  providerType    String                @default("RECHARGE")
  baseUrl         String
  apiKey          String
  isActive        Boolean               @default(false)
  isBlacklisted   Boolean               @default(false)
  priority        Int                   @default(0)
  avgResponseTime Float                 @default(0)
  successRate     Float                 @default(100)
  costPerTxn      Decimal               @default(0) @db.Decimal(10, 2)
  healthStatus    provider_healthStatus @default(UNKNOWN)
  lastCheckAt     DateTime?
  callbackId      String?
  inSwitch        Boolean               @default(false)
  routeType       String                @default("Both")
  apiUrl          String?
  statusCheckUrl  String?
  balanceUrl      String?
  disputeUrl      String?
  maintenanceMode Boolean               @default(false)
  version         Int                   @default(1)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([code])
}

model recharge {
  id            Int         @id @default(autoincrement())
  transactionId Int         @unique
  mobile        String
  operator      String
  providerCode  String?
  failureReason String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  transaction   transaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
}

model transaction {
  id                  Int                    @id @default(autoincrement())
  userId              Int
  amount              Decimal                @db.Decimal(10, 2)
  type                transaction_type
  status              transaction_status     @default(PENDING)
  direction           transaction_direction?
  balanceAfter        Decimal?               @db.Decimal(10, 2)
  mobile              String?
  operator            String?
  cashback            Decimal                @default(0) @db.Decimal(10, 2)
  cashbackCoins       Int                    @default(0)
  rewardClaimed       Boolean                @default(false)
  rewardProcessed     Boolean                @default(false)
  rewardProcessedAt   DateTime?
  commission          Decimal                @default(0) @db.Decimal(10, 2)
  profit              Decimal                @default(0) @db.Decimal(10, 2)
  provider            String?
  providerTxnId       String?
  providerRef         String?                @unique
  providerRefId       String?                @unique @db.VarChar(50)
  amountDeducted      Boolean                @default(false)
  refundStatus        String                 @default("none")
  refundedAt          DateTime?
  idempotencyKey      String?                @unique
  gatewayTxnId        String?
  paymentGateway      String?
  retryCount          Int                    @default(0)
  lastRetryAt         DateTime?
  processingStartedAt DateTime?
  processedAt         DateTime?
  lastStatusCheckAt   DateTime?
  processingLock      Boolean                @default(false)
  rechargeProcessing  Boolean                @default(false)
  adminRetriedBy      Int?
  reviewStatus        String?
  isLocked            Boolean                @default(false)
  description         String?                @db.VarChar(255)
  invoiceSnapshot     Json?
  apiResponse         Json?
  financialSequenceId String?                @unique
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  commissionSnapshot  Json?

  recharge         recharge?
  user             user              @relation(fields: [userId], references: [id])
  coinTransactions coinTransaction[]
  disputes         dispute[]
  ledgerEntries    ledgerEntry[]

  @@index([status])
  @@index([type])
  @@index([userId])
  @@index([createdAt])
  @@index([mobile])
  @@index([financialSequenceId])
  @@index([providerTxnId])
  @@index([providerRefId])
}

model ledgerEntry {
  id                  Int              @id @default(autoincrement())
  userId              Int
  amount              Decimal          @db.Decimal(10, 2)
  balanceBefore       Decimal          @db.Decimal(10, 2)
  balanceAfter        Decimal          @db.Decimal(10, 2)
  type                ledgerEntry_type
  transactionId       Int?
  referenceEntryId    Int?
  referenceId         Int?
  referenceType       String?
  description         String?          @db.VarChar(255)
  metadata            Json?
  financialSequenceId String?          @unique
  createdAt           DateTime         @default(now())

  user        user         @relation(fields: [userId], references: [id])
  transaction transaction? @relation(fields: [transactionId], references: [id])

  @@unique([transactionId, type])
  @@index([userId])
  @@index([createdAt])
  @@index([transactionId])
  @@index([type])
  @@index([financialSequenceId])
}

model cashbackSettings {
  id                     Int         @id @default(1)
  cashbackEnabled        Boolean     @default(true)
  rewardMode             reward_mode @default(PERCENTAGE)
  coinConversionRate     Int         @default(100)
  minRechargeAmount      Decimal     @default(10) @db.Decimal(10, 2)
  maxCashbackPerRecharge Decimal     @default(50) @db.Decimal(10, 2)
  dailyCashbackLimit     Decimal     @default(500) @db.Decimal(10, 2)
  cooldownSeconds        Int         @default(0)
  globalPercentage       Float       @default(1.0)
  operatorWiseCashback   Json?
  slabWiseCashback       Json?
  cashbackExpiryDays     Int         @default(0) // 0 means no expiry
  updatedById            Int?
  updatedAt              DateTime    @updatedAt

  updatedBy user? @relation(fields: [updatedById], references: [id])
}

model dispute {
  id            Int            @id @default(autoincrement())
  userId        Int
  transactionId Int
  type          String
  description   String         @db.Text
  status        dispute_status @default(OPEN)
  remarks       String?        @db.Text
  adminId       Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user        user        @relation(fields: [userId], references: [id])
  transaction transaction @relation(fields: [transactionId], references: [id])
  admin       user?       @relation("adminDisputes", fields: [adminId], references: [id])

  @@index([userId])
  @@index([transactionId])
  @@index([status])
}

model auditLog {
  id        Int      @id @default(autoincrement())
  action    String
  adminId   Int?
  userId    Int?
  entity    String?
  entityId  Int?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  admin user? @relation("adminAudit", fields: [adminId], references: [id])
  user  user? @relation("userAudit", fields: [userId], references: [id])

  @@index([adminId])
  @@index([userId])
  @@index([createdAt])
}

model walletSnapshot {
  id          Int      @id @default(autoincrement())
  userId      Int
  balance     Decimal  @db.Decimal(10, 2)
  coinBalance Int
  createdAt   DateTime @default(now())

  user user @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String   @db.Text
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user user @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([isRead])
}

model user {
  id               Int       @id @default(autoincrement())
  name             String?
  email            String?   @unique
  password         String
  phone            String?   @unique
  isPhoneVerified  Boolean   @default(false)
  isEmailVerified  Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  authType         String    @default("phone")
  role             UserRole  @default(USER)
  referralCode     String?   @unique
  referredBy       Int?
  referralEarnings Decimal   @default(0) @db.Decimal(10, 2)
  tier             String    @default("Standard")
  profileImage     String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  apiAccesses      ApiAccess[]
  apiAccessRequests ApiAccessRequest[]
  apiKeys          apiKey[]
  apiLogs          apiLog[]
  fraudlog         fraudlog[]
  payment          payment[]
  transaction      transaction[]
  coinTransaction  coinTransaction[]
  wallet           wallet?
  ledgerEntries    ledgerEntry[]
  disputes         dispute[]
  adminDisputes    dispute[]          @relation("adminDisputes")
  auditLogs        auditLog[]         @relation("userAudit")
  adminAuditLogs   auditLog[]         @relation("adminAudit")
  walletSnapshots  walletSnapshot[]
  notifications    notification[]
  cashbackSettings cashbackSettings[]
  wishlist         Wishlist?
  orders           Order[]
  outlet             Outlet?
  agreements         Agreement[]
  fosAgent           FosAgent?
  fosAgentId         Int?
  fosRelation        FosAgent?          @relation("FosRetailer", fields: [fosAgentId], references: [id], onDelete: SetNull)
  tempPasswordIssuedAt DateTime?
  mustResetPassword    Boolean   @default(false)
  authVersion          Int       @default(1)
  supportTickets       SupportTicket[]
  partner              Partner?
  packageId            Int?
  package              CommissionPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  slabId               Int?
  slab                 Slab?              @relation(fields: [slabId], references: [id], onDelete: SetNull)
  commissionRole       CommissionRole     @default(CUSTOMER)
  packageAssignedAt    DateTime?
  packageExpiresAt     DateTime?
  slabAssignedAt       DateTime?


  user       user?  @relation("userToUser", fields: [referredBy], references: [id])
  other_user user[] @relation("userToUser")

  @@index([email])
  @@index([phone])
  @@index([referredBy])
}

model apiKey {
  id            Int       @id @default(autoincrement())
  userId        Int
  clientId      String    @unique
  apiKey        String    @unique
  apiSecret     String    @unique
  webhookSecret String?
  isActive      Boolean   @default(true)
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user user @relation(fields: [userId], references: [id])

  @@index([userId])
}

model apiLog {
  id           Int      @id @default(autoincrement())
  userId       Int
  endpoint     String
  method       String
  statusCode   Int
  latency      Int
  ipAddress    String?
  userAgent    String?
  requestBody  Json?
  responseBody Json?
  createdAt    DateTime @default(now())

  user user @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model OTP {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  purpose   String   @default("LOGIN")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

model wallet {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  balance         Decimal  @default(0) @db.Decimal(10, 2)
  cashbackBalance Decimal  @default(0) @db.Decimal(10, 2)
  coinBalance     Int      @default(0)
  currency        String   @default("INR")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user user @relation(fields: [userId], references: [id])

  @@index([userId])
}

model coinTransaction {
  id                  Int                  @id @default(autoincrement())
  userId              Int
  amount              Int
  type                coinTransaction_type
  description         String?
  rechargeTxnId       Int?
  rechargeTxn         transaction?         @relation(fields: [rechargeTxnId], references: [id])
  sourceTransactionId Int?
  createdAt           DateTime             @default(now())
  metadata            Json?
  financialSequenceId String?              @unique

  user user @relation(fields: [userId], references: [id])

  @@unique([rechargeTxnId, type])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([financialSequenceId])
}

enum payment_status {
  PENDING
  PROCESSING
  PROCESSING_REVIEW
  SUCCESS
  FAILED
}

enum transaction_type {
  RECHARGE
  TOPUP
  REFUND
  CASHBACK
  REFERRAL
  WALLET
  BILL_PAYMENT
  POSTPAID
  IMART_BUY
}

enum fraudlog_actionTaken {
  FLAGGED
  BLOCKED
}

enum transaction_status {
  PENDING_REVIEW
  PROCESSING
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum UserRole {
  USER
  API_USER
  ADMIN
  SUPER_ADMIN
}

enum ledgerEntry_type {
  RECHARGE_DEBIT
  CASHBACK_CREDIT
  REFUND_CREDIT
  REDEMPTION_DEBIT
  REVERSAL_CREDIT
  ADMIN_ADJUSTMENT
  TOPUP_CREDIT
  IMART_DEBIT
}

enum reward_mode {
  PERCENTAGE
  RANDOM
}

enum dispute_status {
  OPEN
  UNDER_REVIEW
  PROVIDER_ESCALATED
  RESOLVED
  REJECTED
}

enum transaction_direction {
  CREDIT
  DEBIT
}

enum payment_intent {
  TOPUP
  RECHARGE
  IMART
}

enum provider_healthStatus {
  HEALTHY
  DEGRADED
  DOWN
  UNKNOWN
}

enum coinTransaction_type {
  EARNED
  REDEEMED
}

model idempotencyRecord {
  key         String   @id
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  requestHash String   @db.VarChar(64)
  status      String   @default("PENDING") // PENDING, SUCCESS, FAILED
}

model dlqEntry {
  id            Int      @id @default(autoincrement())
  eventType     String
  payload       Json
  error         String?  @db.Text
  retryCount    Int      @default(0)
  nextRetryAt   DateTime @default(now())
  status        String   @default("FAILED") // FAILED, RETRYING, RESOLVED
  failureReason String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id             Int            @id @default(autoincrement())
  name           String
  slug           String         @unique
  description    String         @db.Text
  specifications Json?
  price          Decimal        @db.Decimal(10, 2)
  discountPrice  Decimal?       @db.Decimal(10, 2)
  stock          Int            @default(0)
  featured       Boolean        @default(false)
  categoryId     Int
  category       Category       @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String  @db.Text

  @@index([productId])
}

model Wishlist {
  id        Int            @id @default(autoincrement())
  userId    Int            @unique
  user      user           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  wishlistId Int
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
}

model Order {
  id             Int         @id @default(autoincrement())
  userId         Int
  user           user        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtotalAmount Decimal     @default(0.00) @db.Decimal(10, 2)
  gstAmount      Decimal     @default(0.00) @db.Decimal(10, 2)
  gstRate        Decimal     @default(18.00) @db.Decimal(5, 2)
  totalAmount    Decimal     @db.Decimal(10, 2)
  paymentId      Int?        @unique
  payment        payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  paymentStatus  String      @default("PENDING") // PENDING, SUCCESS, FAILED
  gatewayRef     String?
  paymentMethod  String?
  invoiceId      String?     @unique
  paidAt         DateTime?
  status         String      @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
  @@index([paymentStatus])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  price     Decimal @db.Decimal(10, 2)
  quantity  Int

  @@index([orderId])
  @@index([productId])
}

model ApiAccess {
  id            String     @id @default(cuid())
  userId        Int
  apiKey        String     @unique
  apiSecretHash String
  webhookUrl    String?
  isActive      Boolean    @default(true)
  rateLimit     Int        @default(100)
  environment   String     @default("PRODUCTION")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          user       @relation(fields: [userId], references: [id])
  usages        ApiUsage[]

  @@index([userId])
}

model ApiUsage {
  id          String    @id @default(cuid())
  apiAccessId String
  endpoint    String
  method      String
  statusCode  Int
  latency     Int
  ipAddress   String?
  createdAt   DateTime  @default(now())

  apiAccess   ApiAccess @relation(fields: [apiAccessId], references: [id])

  @@index([apiAccessId])
  @@index([createdAt])
}

model WebhookEvent {
  id             String   @id @default(cuid())
  apiAccessId    String
  eventType      String
  payload        Json
  deliveryStatus String
  responseCode   Int?
  retryCount     Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([apiAccessId])
}

model ApiAccessRequest {
  id          String   @id @default(cuid())
  userId      Int
  status      String   @default("PENDING")
  reason      String?
  approvedBy  Int?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())

  user user @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  role      String   @default("STAFF")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance Attendance[]
  meetings   EmployeeMeeting[]
}

model Attendance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  checkIn    DateTime @default(now())
  checkOut   DateTime?
  status     String   @default("PRESENT")
  location   String?
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Meeting {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  startTime   DateTime
  endTime     DateTime
  location    String?
  createdAt   DateTime @default(now())

  attendees EmployeeMeeting[]
}

model EmployeeMeeting {
  employeeId Int
  meetingId  Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@id([employeeId, meetingId])
}

model Outlet {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  name      String
  ownerName String
  address   String   @db.Text
  city      String
  state     String
  pincode   String
  latitude  Float?
  longitude Float?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Agreement {
  id          Int       @id @default(autoincrement())
  userId      Int
  title       String
  content     String    @db.Text
  status      String    @default("PENDING")
  signedAt    DateTime?
  filePath    String?   @db.Text
  uploadedBy  Int?
  reviewedBy  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FosAgent {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  region             String?
  targetOnboardings  Int      @default(50)
  currentOnboardings Int      @default(0)
  createdAt          DateTime @default(now())

  user               user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  retailers          user[]   @relation("FosRetailer")
}

model RolePermission {
  id         Int      @id @default(autoincrement())
  role       String
  module     String
  canRead    Boolean  @default(true)
  canWrite   Boolean  @default(false)
  canDelete  Boolean  @default(false)
  canApprove Boolean  @default(false)
  canAdjust  Boolean  @default(false)
  updatedBy  Int?
  updatedAt  DateTime @updatedAt

  @@unique([role, module])
}

model SupportTicket {
  id            Int      @id @default(autoincrement())
  userId        Int
  subject       String
  description   String   @db.Text
  priority      String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status        String   @default("OPEN")   // OPEN, UNDER_REVIEW, RESOLVED, CLOSED
  assignedTo    Int?     // Employee or Admin ID
  attachmentUrl String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Partner {
  id                Int      @id @default(autoincrement())
  type              String   @default("RETAILER") // DISTRIBUTOR, RETAILER
  parentId          Int?
  walletBalance     Decimal  @default(0) @db.Decimal(10, 2)
  commissionProfile String?
  status            String   @default("ACTIVE")
  userId            Int      @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProviderHealthLog {
  id           Int      @id @default(autoincrement())
  providerCode String
  status       String
  latency      Int
  message      String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([providerCode])
}

model OperatorMapping {
  id                   Int      @id @default(autoincrement())
  operatorName         String
  circleName           String   @default("ALL")
  providerCode         String
  providerOperatorCode String
  minAmount            Decimal  @default(0.00) @db.Decimal(10, 2)
  maxAmount            Decimal  @default(99999.00) @db.Decimal(10, 2)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([providerCode])
  @@index([operatorName])
}

model RoutingRule {
  id                 Int      @id @default(autoincrement())
  name               String
  ruleType           String   // 'operator', 'user', 'amount', 'circle'
  targetValue        String   // e.g. 'JIO', 'userId_123', 'circle_DELHI'
  providerCode       String
  backupProviderCode String?
  priority           Int      @default(1)
  minAmount          Decimal  @default(0.00) @db.Decimal(10, 2)
  maxAmount          Decimal  @default(99999.00) @db.Decimal(10, 2)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([ruleType, targetValue])
}

model WhatsappTemplate {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  templateId  String
  body        String   @db.Text
  variables   Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NotificationLog {
  id           Int      @id @default(autoincrement())
  recipient    String
  channel      String   @default("WHATSAPP")
  templateName String
  status       String   // 'DELIVERED', 'FAILED', 'PENDING'
  response     Json?
  createdAt    DateTime @default(now())

  @@index([recipient])
}

model ApiFailoverLog {
  id                   Int      @id @default(autoincrement())
  transactionId        Int
  failedProviderCode   String
  switchedProviderCode String
  reason               String?  @db.Text
  createdAt            DateTime @default(now())

  @@index([transactionId])
}

model RoutingDecisionLog {
  id                  Int      @id @default(autoincrement())
  txnId               Int
  operator            String
  amount              Decimal  @db.Decimal(10, 2)
  recommendedProvider String
  executedProvider    String
  shadowMode          Boolean  @default(true)
  routingReason       String?  @db.Text
  latency             Int
  createdAt           DateTime @default(now())

  @@index([txnId])
}


enum CommissionRole {
  SUPER_ADMIN
  SUB_ADMIN
  MASTER_DISTRIBUTOR
  DISTRIBUTOR
  RETAILER
  API_USER
  CUSTOMER
}

enum CommissionStatus {
  PENDING
  APPROVED
  ACTIVE
  REJECTED
}

enum CommissionValueType {
  PERCENTAGE
  FLAT
}

enum CommissionMode {
  GENERAL
  REAL
}

enum BulkAction {
  INCREASE
  DECREASE
  REPLACE
  COPY
  RESET
}

enum BulkJobStatus {
  COMPLETED
  ROLLED_BACK
}

enum CommissionRuleType {
  RECHARGE
  RANGE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  CLONE
  BULK_UPDATE
  ROLLBACK
  APPROVAL
}

model ServiceCategory {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  packageSlabs  PackageServiceSlab[]
  rechargeRules RechargeCommissionRule[]
  rangeRules    RangeCommissionRule[]
}

model Slab {
  id             Int                      @id @default(autoincrement())
  name           String                   @unique
  description    String?
  isActive       Boolean                  @default(true)
  isDefault      Boolean                  @default(false)
  isDeleted      Boolean                  @default(false)
  deletedAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  rechargeRules  RechargeCommissionRule[]
  rangeRules     RangeCommissionRule[]
  packageSlabs   PackageServiceSlab[]
  bulkJobs       BulkCommissionJobSlab[]
  users          user[]


  @@index([isDeleted])
  @@index([isDefault])
}

model CommissionPackage {
  id             Int                  @id @default(autoincrement())
  name           String               @unique
  description    String?
  cost           Float                @default(0.0)
  expiryDays     Int?
  isDefault      Boolean              @default(false)
  selfAssignment Boolean              @default(false)
  isActive       Boolean              @default(true)
  isDeleted      Boolean              @default(false)
  deletedAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  packageSlabs   PackageServiceSlab[]
  users          user[]

  @@index([isDeleted])
}

model PackageServiceSlab {
  id                Int               @id @default(autoincrement())
  packageId         Int
  serviceCategoryId Int
  slabId            Int
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  package         CommissionPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory   @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)
  slab            Slab              @relation(fields: [slabId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceCategoryId])
  @@index([packageId])
  @@index([serviceCategoryId])
  @@index([slabId])
}

model RechargeCommissionRule {
  id                Int                 @id @default(autoincrement())
  slabId            Int
  operatorId        Int
  serviceCategoryId Int
  role              CommissionRole
  commissionType    CommissionValueType @default(PERCENTAGE)
  commissionValue   Float               @default(0.0)
  realCommission    Float               @default(0.0)
  surchargeType     CommissionValueType @default(PERCENTAGE)
  surchargeValue    Float               @default(0.0)
  profitType        CommissionValueType @default(PERCENTAGE)
  profitValue       Float               @default(0.0)
  feeType           CommissionValueType @default(PERCENTAGE)
  feeValue          Float               @default(0.0)
  maxCommission     Float?
  fixedCharge       Float               @default(0.0)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  status            CommissionStatus    @default(PENDING)
  approvedById      Int?
  approvedAt        DateTime?
  approvalComment   String?
  version           Int                 @default(1)
  isDeleted         Boolean             @default(false)
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  slab            Slab            @relation(fields: [slabId], references: [id], onDelete: Cascade)
  operatorRel     operator        @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  @@index([slabId, operatorId, serviceCategoryId, role])
  @@index([status])
  @@index([slabId])
  @@index([operatorId])
  @@index([serviceCategoryId])
  @@index([role])
  @@index([isDeleted])
  @@index([operatorId, serviceCategoryId])
  @@index([operatorId, role])
}

model RangeCommissionRule {
  id                Int                 @id @default(autoincrement())
  slabId            Int
  operatorId        Int
  serviceCategoryId Int
  amountFrom        Float
  amountTo          Float
  role              CommissionRole
  mode              CommissionMode      @default(GENERAL)
  commissionType    CommissionValueType @default(PERCENTAGE)
  commissionValue   Float               @default(0.0)
  realCommission    Float               @default(0.0)
  surchargeType     CommissionValueType @default(PERCENTAGE)
  surchargeValue    Float               @default(0.0)
  profitType        CommissionValueType @default(PERCENTAGE)
  profitValue       Float               @default(0.0)
  feeType           CommissionValueType @default(PERCENTAGE)
  feeValue          Float               @default(0.0)
  maxCommission     Float?
  fixedCharge       Float               @default(0.0)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  status            CommissionStatus    @default(PENDING)
  approvedById      Int?
  approvedAt        DateTime?
  approvalComment   String?
  version           Int                 @default(1)
  isDeleted         Boolean             @default(false)
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  slab            Slab            @relation(fields: [slabId], references: [id], onDelete: Cascade)
  operatorRel     operator        @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  @@index([slabId])
  @@index([operatorId])
  @@index([serviceCategoryId])
  @@index([amountFrom])
  @@index([amountTo])
  @@index([role])
  @@index([status])
  @@index([isDeleted])
  @@index([operatorId, serviceCategoryId])
  @@index([operatorId, role])
}

model BulkCommissionJob {
  id                Int              @id @default(autoincrement())
  action            BulkAction
  mode              CommissionMode
  commissionType    String           // e.g. "COMMISSION", "SURCHARGE", "PROFIT", "FEE"
  serviceCategoryId Int?
  operatorId        Int?
  params            Json
  oldValues         Json
  newValues         Json
  status            BulkJobStatus    @default(COMPLETED)
  createdById       Int
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  slabs             BulkCommissionJobSlab[]
}

model BulkCommissionJobSlab {
  id        Int               @id @default(autoincrement())
  jobId     Int
  slabId    Int
  job       BulkCommissionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  slab      Slab              @relation(fields: [slabId], references: [id], onDelete: Cascade)

  @@unique([jobId, slabId])
  @@index([jobId])
  @@index([slabId])
}

model BulkCommissionAudit {
  id        Int      @id @default(autoincrement())
  jobId     Int?
  action    AuditAction
  details   Json
  ipAddress String?
  createdAt DateTime @default(now())
}

model CommissionRuleHistory {
  id          Int            @id @default(autoincrement())
  ruleId      Int?
  ruleType    CommissionRuleType
  operatorId  Int
  role        CommissionRole
  oldValue    Float
  newValue    Float
  oldMode     CommissionMode?
  newMode     CommissionMode?
  oldRole     CommissionRole?
  newRole     CommissionRole?
  oldAmountFrom Float?
  newAmountFrom Float?
  oldAmountTo   Float?
  newAmountTo   Float?
  changedById Int
  ipAddress   String?
  createdAt   DateTime       @default(now())
}

model CommissionConfig {
  id                      Int      @id @default(1)
  currentVersion          Int      @default(1)
  commissionEngineVersion String   @default("LEGACY")
  rolloutPercent          Int      @default(0)
  updatedAt               DateTime @updatedAt
}


model CommissionShadowValidation {
  id              Int      @id @default(autoincrement())
  transactionId   Int
  userId          Int
  operatorId      Int
  amount          Decimal  @db.Decimal(10, 2)
  legacyResult    Json
  simulatorResult Json
  isMatch         Boolean
  mismatchReason  String?  @db.VarChar(255)
  createdAt       DateTime @default(now())

  @@index([transactionId])
  @@index([userId])
  @@index([operatorId])
  @@index([isMatch])
  @@index([createdAt])
}




