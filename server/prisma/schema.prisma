enum CommissionRole {
  SUPER_ADMIN
  SUB_ADMIN
  MASTER_DISTRIBUTOR
  DISTRIBUTOR
  RETAILER
  API_USER
  CUSTOMER
}

enum CommissionStatus {
  PENDING
  APPROVED
  ACTIVE
  REJECTED
}

enum CommissionValueType {
  PERCENTAGE
  FLAT
}

enum CommissionMode {
  GENERAL
  REAL
}

enum BulkAction {
  INCREASE
  DECREASE
  REPLACE
  COPY
  RESET
}

enum BulkJobStatus {
  COMPLETED
  ROLLED_BACK
}

enum CommissionRuleType {
